{
  "name": "venom-router",
  "version": "1.4.1",
  "description": "LLM model router — one endpoint across every provider and key",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable",
    "publish": "electron-builder --win --x64 --publish always",
    "release": "node scripts/release.mjs",
    "check:keystore": "electron scripts/keystore-check.js",
    "postinstall": "electron-builder install-app-deps",
    "verify:live": "node scripts/live/verify-db.mjs",
    "check:import": "node scripts/check-import-counts.js",
    "test": "node scripts/run-tests.js"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "VENOMDRMSUPPORT",
      "repo": "upstream-checker",
      "releaseType": "release"
    },
    "appId": "com.upstream.checker",
    "productName": "VENOM Router",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "VENOM-Router-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "VENOM Router - Portable.exe"
    },
    "files": [
      "src/**/*"
    ]
  },
  "dependencies": {
    "better-sqlite3": "~12.11.1",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.4"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
