+}
+.mc-card-detail .mc-detail-grid { grid-template-columns: 1fr; padding: 12px 0 0; border-top: 1px dashed var(--border-1); }
+@container dt (max-width: 900px) {
+  .mc-detail-grid { grid-template-columns: 1fr; padding-left: 16px; }
+}
+.mc-panel {
+  padding: 14px;
+  border: 1px solid var(--border-1);
+  border-radius: var(--radius-lg);
+  background: var(--bg-2);
+  white-space: normal;
+}
+.mc-panel-head {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  margin-bottom: 10px;
+  font-size: 12px;
+  font-weight: 600;
+  color: var(--text-0);
+}
+.mc-panel-head .mc-muted { font-weight: 500; }
+.mc-muted { color: var(--text-3); font-size: 12px; line-height: 1.5; margin: 0 0 10px; }
+.mc-source { margin: 10px 0 0; font-size: 10.5px; color: var(--text-4); line-height: 1.5; }
+.mc-compare { display: grid; gap: 4px; }
+.mc-compare-row {
