+}
+.ku-inline:hover { background: var(--bg-3); border-color: var(--border-2); }
+.ku-inline.ku-skel { min-width: 180px; border-style: dashed; }
+.ku-inline > .ku-inline-quota,
+.ku-inline > .ku-expiry { grid-column: 1; }
+.ku-inline > svg { grid-column: 2; grid-row: 1 / span 2; color: var(--text-3); }
+.ku-inline > .ku-dot { display: none; }
+.ku-inline.ku-cell-fail { display: inline-flex; }
+.ku-inline-quota { display: flex; flex-direction: column; gap: 4px; min-width: 0; font-variant-numeric: tabular-nums; }
+.ku-inline-quota .dt-rate-bar { width: 100%; min-width: 0; flex: none; }
+.ku-inline-num { white-space: nowrap; }
+.ku-inline .ku-expiry { flex-direction: row; font-size: 11.5px; }
+.ku-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--text-4); }
+
+/* Drawer */
+/* ============================================
+   Catalog: live health badge + toast notifications
+   ============================================ */
+.mc-health {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 1px 7px;
+  border-radius: 999px;
+  font-size: 10px;
+  font-weight: 600;
+  letter-spacing: 0.02em;
+  border: 1px solid transparent;
+  white-space: nowrap;
+}
+.mc-health svg { width: 10px; height: 10px; }
+.mc-health-ok { color: var(--pass); background: color-mix(in srgb, var(--pass) 12%, transparent); border-color: color-mix(in srgb, var(--pass) 25%, transparent); }
+.mc-health-warn { color: var(--warn); background: color-mix(in srgb, var(--warn) 12%, transparent); border-color: color-mix(in srgb, var(--warn) 25%, transparent); }
+.mc-health-fail { color: var(--fail); background: color-mix(in srgb, var(--fail) 12%, transparent); border-color: color-mix(in srgb, var(--fail) 25%, transparent); }
+
+.mc-toasts {
+  position: fixed;
+  right: 18px;
+  bottom: 18px;
+  z-index: 9600;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  max-width: min(380px, calc(100vw - 36px));
+  pointer-events: none;
+}
+.mc-toast {
+  display: flex;
+  align-items: flex-start;
+  pointer-events: auto;
+  gap: 9px;
+  padding: 10px 12px;
+  border-radius: var(--radius-md);
+  border: 1px solid var(--border-2);
+  background: var(--bg-1);
+  box-shadow: var(--shadow-lg);
+  color: var(--text-1);
+  font-size: 12.5px;
+  line-height: 1.4;
+  opacity: 0;
+  transform: translateY(8px);
+  transition: opacity 180ms ease, transform 180ms ease;
+}
+.mc-toast.show { opacity: 1; transform: none; }
+.mc-toast-ico { display: grid; place-items: center; flex-shrink: 0; margin-top: 1px; }
+.mc-toast-ico svg { width: 13px; height: 13px; }
+.mc-toast-ok .mc-toast-ico { color: var(--pass); }
+.mc-toast-warn .mc-toast-ico { color: var(--warn); }
+.mc-toast-fail .mc-toast-ico { color: var(--fail); }
+.mc-toast-info .mc-toast-ico { color: var(--accent-text); }
+.mc-toast-undo {
+  margin-left: auto;
+  background: transparent;
+  border: 1px solid var(--border-2);
