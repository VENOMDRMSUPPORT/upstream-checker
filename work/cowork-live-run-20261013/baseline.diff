+}
+.pv-tag.mc-new { --tag: var(--accent-text); animation: mc-pulse 2.4s ease-in-out infinite; }
+@keyframes mc-pulse { 50% { box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent); } }
+.mc-na { font-size: 11px; }
+
+/* A value borrowed from the sources rather than published by the provider. The
+   mark says so where the number is drawn, so a filled-in price or context
+   window never reads as the provider's own claim. */
+.mc-borrowed { border-bottom: 1px dotted var(--text-4); cursor: help; }
+
+.mc-error { margin-top: 4px; font-size: 11px; color: var(--fail); }
+
+/* Detail panel */
+.mc-detail > td { padding: 0 !important; }
+.mc-detail-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr);
+  gap: 14px;
+  padding: 14px 16px 18px 50px;
