+}
+.ku-skel span:first-child { width: 100%; }
+.ku-skel span + span { width: 60%; }
+@keyframes ku-shimmer {
+  from { background-position: 100% 0; }
+  to { background-position: -100% 0; }
+}
+
+/* Card view: both readings on one line under the key's meta. */
+/* Quota over expiry, the details icon beside both. */
+.ku-inline {
+  display: inline-grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  align-items: center;
+  column-gap: 10px;
+  row-gap: 4px;
