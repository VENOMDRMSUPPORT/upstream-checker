+.mc-compare-row > span:first-child { color: var(--text-2); }
+.mc-compare-row > span:not(:first-child) { font-family: 'JetBrains Mono', monospace; font-weight: 600; color: var(--text-0); display: inline-flex; align-items: center; gap: 5px; }
+.mc-compare-row small { font-weight: 500; color: var(--text-4); }
+.mc-verdict-line {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin-top: 10px;
+  padding: 7px 10px;
+  border-radius: var(--radius-md);
+  font-size: 12px;
+  font-weight: 600;
+}
+
+/* Cards */
+.mc-card-badges { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; min-height: 20px; }
+.mc-card .pv-stat-value { font-size: 14px; }
+.mc-card .pv-card-actions .dt-icon-btn { margin-left: auto; }
+
+/* The catalogue table is wide. Columns step out as the container narrows so
+   the actions column never slides under a long model name; everything hidden
+   here is still in the row's detail panel. */
+.mc-table :is(th, td) { padding-left: 11px; padding-right: 11px; }
+.mc-table .col-score { min-width: 80px; }
+.mc-table .col-caps { min-width: 152px; }
+@container dt (max-width: 1150px) { .mc-sub code { display: none; } }
+@container dt (max-width: 820px) { .mc-table :is(.col-lat, .col-speed) { display: none; } }
+@container dt (max-width: 680px) { .mc-table .col-ctx { display: none; } }
+/* Eight icons is a wider column than three letters were, so Caps is the column
+   that steps out last rather than the first — it is the one the legend exists to
+   make readable. Everything in it is still in the row's detail panel. */
+@container dt (max-width: 540px) { .mc-table .col-caps { display: none; } }
+.mc-side { display: grid; gap: 14px; align-content: start; }
+
+/* ---- Capabilities: one icon per capability, on the legend and on every row --
+   The eight marks are drawn once here and twice in markup (legend tile, row
+   cell), so a meaning is learned in one place and read in the other. Colour is
+   per capability and never per state — the owner asked for that, and it is what
+   makes a row scannable at a glance: eight fixed hues, brightness for the state.
+   The state vocabulary is two, not three. `true` is lit; `null` (nobody published
+   it) is dim; `false` is NOT EMITTED at all, because a red mark on every row for
+   every capability a provider does not mention says "cannot" where the truth is
+   "has never been heard of". The row's detail panel says the negatives in words. */
+.mc-cap-ico {
+  --cap: var(--text-3);
+  display: inline-grid;
+  place-items: center;
+  width: 20px;
+  height: 20px;
+  flex-shrink: 0;
+  color: var(--cap);
+}
+.mc-cap-ico svg { display: block; width: 14px; height: 14px; }
+/* The reasoning mark is the emoji itself, not an SVG: it needs no stroke
+   colour and no glow fix — the glyph carries its own shape at any size. */
+.emoji-cap { font-size: 13px; line-height: 1; font-style: normal; }
+.mc-cap-ico.is-yes { opacity: 1; }
+/* 0.3 rather than a grey: it is the SAME hue at a tenth of the emphasis, so a
+   dimmed mark still reads as its capability and not as a disabled control. */
+.mc-cap-ico.is-unknown { opacity: 0.22; }
+
+/* The fixed palette. One custom property per capability, so the row cell and the
+   legend tile can never drift apart and a new state rule stays in one place. */
+.mc-cap-tool { --cap: #f5b83d; }
+.mc-cap-reasoning { --cap: #a78bfa; }
+.mc-cap-structured { --cap: #5b9df9; }
+.mc-cap-vision { --cap: #3fbf6a; }
+.mc-cap-imagegen { --cap: #f472b6; }
+.mc-cap-audio { --cap: #f0524d; }
+.mc-cap-video { --cap: #2fc6b4; }
+.mc-cap-files { --cap: #818cf8; }
+.mc-cap-decision { --cap: #34d399; }
+/* Daylight redefines --pass/--warn/--fail and nothing else (line ~3310), so
+   these eight hexes would sit light-on-white. The same tokens, deepened — the
+   same move `.type-vision` etc. already make for their own hues. */
+[data-theme="daylight"] .mc-cap-tool { --cap: #b47c12; }
+[data-theme="daylight"] .mc-cap-reasoning { --cap: #7c55d8; }
+[data-theme="daylight"] .mc-cap-structured { --cap: #2b6ec9; }
+[data-theme="daylight"] .mc-cap-vision { --cap: #1f8a45; }
+[data-theme="daylight"] .mc-cap-imagegen { --cap: #c0367f; }
+[data-theme="daylight"] .mc-cap-audio { --cap: #c62822; }
+[data-theme="daylight"] .mc-cap-video { --cap: #0d8a7c; }
+[data-theme="daylight"] .mc-cap-files { --cap: #4f52c9; }
+[data-theme="daylight"] .mc-cap-decision { --cap: #047857; }
+
+/* The row cell. Icons keep their own size in a cell that is otherwise numerals,
+   so the column is set by the icons rather than by the header's word. */
+.mc-caps { display: inline-flex; align-items: center; gap: 1px; margin-left: 2px; }
+/* A row with nothing published at all wears no marks: eight dim icons would be
+   eight claims, and the empty cell says "nothing published" better. */
+.mc-caps.is-silent { margin-left: 0; }
+
+/* Capabilities legend: unified with .pv-legend system */
+.pv-legend.mc-legend .mc-legend-ico { color: var(--c); }
+.pv-legend.mc-legend .mc-legend-ico svg { display: block; width: 15px; height: 15px; }
+.mc-legend-top-caps {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+}
+.mc-legend-top-caps .mc-cap-ico {
+  width: 18px;
+  height: 18px;
+  border-radius: 4px;
+  transition: transform var(--transition-fast), background var(--transition-fast);
+}
+.mc-legend-top-caps .mc-cap-ico:hover {
+  background: var(--bg-3);
+  transform: scale(1.1);
+}
+.mc-legend-top-caps .mc-cap-ico svg {
+  display: block;
+  width: 13px;
+  height: 13px;
+}
+.mc-legend-body[hidden] { display: none; }
+
+/* The detail panel's capability list. A third state lives here only: the "no"
