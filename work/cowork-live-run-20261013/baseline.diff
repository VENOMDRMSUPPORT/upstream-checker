+.mc-cap-mark { display: inline-grid; place-items: center; width: 16px; height: 16px; color: var(--text-4); }
+.mc-cap-mark svg { display: block; width: 13px; height: 13px; }
+.mc-cap-mark.is-yes { color: var(--pass); }
+.mc-cap-mark.is-no { color: var(--fail); }
+.mc-cap-from {
+  margin-left: 7px;
+  font-family: 'Inter', sans-serif;
+  font-size: 10.5px;
+  font-weight: 400;
+  color: var(--text-4);
+}
+.mc-ok { color: var(--pass); }
+.mc-no { color: var(--fail); }
+.mc-note { font-size: 11px; color: var(--text-4); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.mc-compare-row > span.mc-note { font-family: 'Inter', sans-serif; font-weight: 500; color: var(--text-4); }
+.mc-price-free {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  color: var(--pass);
+  font-weight: 600;
+}
+.mc-price-paid {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+}
+/* ---- Health Status Bar (Uptime / Checks ticks like status monitors) ---- */
+.mc-health-bar-wrap {
+  display: inline-flex;
+  flex-direction: column;
+  align-items: stretch;
+  width: 130px;
+  gap: 3px;
+  user-select: none;
+  vertical-align: middle;
+}
+
+.mc-health-ticks {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  height: 16px;
+  gap: 2px;
+}
+
+.mc-health-tick {
+  flex: 1;
+  min-width: 2px;
+  max-width: 5px;
+  height: 15px;
+  border-radius: 999px;
+  flex-shrink: 0;
+  transition: transform var(--transition-fast, 0.15s ease), opacity var(--transition-fast, 0.15s ease);
+}
+
+.mc-health-tick:hover {
+  transform: scaleY(1.3);
+  z-index: 2;
+}
+
+.mc-health-tick.pass,
+.mc-health-tick.healthy {
+  background: var(--pass, #10b981);
+}
+
+.mc-health-tick.fail,
+.mc-health-tick.error {
+  background: var(--fail, #ef4444);
+}
+
+.mc-health-tick.warn {
+  background: var(--warn, #f59e0b);
+}
+
+.mc-health-tick.empty {
+  background: color-mix(in srgb, var(--border-2) 65%, transparent);
+  opacity: 0.35;
+}
+
+.mc-health-labels {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  font-size: 8px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  color: var(--text-4, #64748b);
+  line-height: 1;
+  text-transform: uppercase;
+}
+
+.mc-card-health {
+  margin-top: 8px;
+  display: flex;
+  justify-content: center;
+}
+.mc-card-health .mc-health-bar-wrap {
+  width: 100%;
+}
+
+.mc-speed-val {
+  font-variant-numeric: tabular-nums;
+  font-weight: 600;
+}
+.mc-speed-unit {
+  font-size: 10px;
+  font-weight: 500;
+  color: var(--text-3);
+  margin-left: 2px;
+}
+
+/* Sources status: the same four facts per upstream document, one line each.
+   Scoped under .mc-sources on purpose: a bare `.mc-source` already lives a few
+   hundred lines above and is the detail drawer's "Source: …" line
+   (src/renderer/catalog.js 1206, src/renderer/profiles.js 425). Left unscoped,
+   this rule would have restyled that page — which is not this task's page.
+   The tone vocabulary is .mc-health's (--pass / --warn / --fail), so the block
+   reads as the same system in light and dark. */
+.mc-sources { display: grid; gap: 4px; margin-top: 8px; }
+.mc-sources-head { font-size: 11.5px; font-weight: 600; color: var(--text-2); }
+.mc-sources .mc-source {
+  display: grid;
+  grid-template-columns: 1fr auto auto;
+  gap: 10px;
+  align-items: baseline;
+  margin: 0;
+  font-size: 12px;
+  line-height: 1.5;
+  color: var(--text-1);
+}
+.mc-sources .mc-source > b { font-variant-numeric: tabular-nums; }
+.mc-sources .mc-source > span:nth-child(3) { color: var(--text-3); font-size: 11.5px; }
+.mc-source-ok > b { color: var(--pass); }
+.mc-source-warn > b { color: var(--warn); }
+.mc-source-fail > b { color: var(--fail); }
+.mc-source-error { grid-column: 1 / -1; color: var(--text-3); font-size: 11px; }
+/* The block's own failure — the Sync sources button could not do what it said. It
+   sits above the four lines rather than replacing them, so the owner still sees
+   what is on disk, and it is --fail rather than --text-3 because nothing else on
+   this plane tells them a thing went wrong. */
+.mc-sources-error { color: var(--fail); font-size: 11.5px; font-weight: 600; }
+
+/* ============================================
+   Key usage (key-usage.js) — quota and expiry in the key row, the rest in a
+   drawer from the right
+   ============================================ */
+.ku-cell {
+  display: flex;
+  flex-direction: column;
+  align-items: stretch;
+  gap: 4px;
+  width: calc(100% + 16px);
+  min-width: 0;
+  padding: 5px 8px;
+  margin: -5px -8px;
+  border: 1px solid transparent;
+  border-radius: var(--radius-md);
+  background: none;
+  color: var(--text-1);
+  font: inherit;
+  font-size: 12px;
+  text-align: left;
+  cursor: pointer;
+  transition: background var(--transition-fast), border-color var(--transition-fast);
+}
+button.ku-cell:hover {
+  background: var(--bg-3);
+  border-color: var(--border-2);
+}
+/* Unlimited weekly usage: the track is intentionally open-ended rather than
+   pretending that an unlimited plan has a finite remaining percentage. */
+.ku-unlimited-line { display: flex; align-items: center; }
+.ku-unlimited-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 1px 7px;
+  border-radius: 10px;
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 10.5px;
+  font-weight: 600;
+  color: var(--pass);
+  background: color-mix(in srgb, var(--pass) 12%, transparent);
+  border: 1px solid color-mix(in srgb, var(--pass) 24%, transparent);
+  white-space: nowrap;
+}
+.ku-unlimited-track {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  width: 100%;
+  color: var(--text-2);
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 10px;
+  font-variant-numeric: tabular-nums;
+}
+.ku-unlimited-track .ku-unlimited-start,
+.ku-unlimited-track .ku-unlimited-end { flex-shrink: 0; color: var(--text-3); }
+.ku-unlimited-fill {
+  position: relative;
+  flex: 1;
+  height: 5px;
+  border-radius: 3px;
+  background: linear-gradient(90deg, var(--pass), color-mix(in srgb, var(--accent) 70%, var(--pass)) 72%, var(--accent));
+  box-shadow: 0 0 8px -3px var(--accent);
+}
+.ku-unlimited-fill::after {
+  content: '';
+  position: absolute;
+  right: 0;
+  top: 50%;
+  width: 7px;
+  height: 7px;
+  border: 2px solid var(--accent);
+  border-radius: 50%;
+  background: var(--bg-1);
+  transform: translate(50%, -50%);
+}
+.ku-unlimited-hero { display: flex; align-items: baseline; gap: 10px; }
+.ku-unlimited-hero-value { color: var(--text-0); font-size: 24px; font-weight: 700; letter-spacing: 0; }
+.ku-unlimited-track-lg { margin-top: 14px; gap: 10px; font-size: 11px; }
+.ku-unlimited-track-lg .ku-unlimited-fill { height: 7px; }
+.ku-unlimited-note { margin-top: 14px; color: var(--text-2); font-size: 12px; line-height: 1.55; }
+.ku-inline-unlimited { display: flex; flex-direction: column; gap: 4px; min-width: 150px; }
+.ku-inline-unlimited .ku-unlimited-track { min-width: 130px; }
+
+.ku-cell.is-loading { opacity: 0.6; }
+.ku-quota-line {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+.ku-quota-line .dt-rate-bar { min-width: 48px; }
+.ku-quota-line b {
+  min-width: 42px;
+  font-weight: 600;
+  font-variant-numeric: tabular-nums;
+  color: var(--text-0);
+  text-align: right;
+}
+.ku-sub {
+  font-size: 11px;
+  font-variant-numeric: tabular-nums;
+  color: var(--text-2);
+  white-space: nowrap;
+}
+.ku-cell-fail {
+  flex-direction: row;
+  align-items: center;
+  gap: 6px;
+  color: var(--fail);
+}
+.ku-cell-fail svg { flex-shrink: 0; }
+.ku-expiry {
+  display: inline-flex;
+  flex-direction: column;
+  gap: 2px;
+  font-size: 12px;
+}
+.ku-expiry b { font-weight: 600; color: var(--text-0); white-space: nowrap; }
+.ku-expiry[data-tone="low"] b { color: var(--warn); }
+.ku-expiry[data-tone="bad"] b { color: var(--fail); }
+
+/* Loading placeholders */
+.ku-skel { cursor: default; gap: 6px; }
+.ku-skel span,
+.ku-hero-skel span,
+.ku-table-skel span {
+  display: block;
+  height: 8px;
+  border-radius: 4px;
+  background: linear-gradient(90deg, var(--bg-3), color-mix(in srgb, var(--bg-3) 40%, var(--border-2)), var(--bg-3));
+  background-size: 200% 100%;
